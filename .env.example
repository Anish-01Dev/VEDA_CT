# ── Gemini AI Keys ──────────────────────────────────────────
# Text / Chat AI (all non-vision features)
VITE_GEMINI_TEXT_KEY=your_gemini_text_key_here

# Vision / Image AI (prescription scanner, food analysis, lab reports)
VITE_GEMINI_VISION_KEY=your_gemini_vision_key_here

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── SambaNova ────────────────────────────────────────────────
VITE_SAMBANOVA_API_KEY=your_sambanova_key_here

# ── App Config ───────────────────────────────────────────────
VITE_DEV_MODE=true
VITE_APP_NAME=Pixal Health
VITE_APP_VERSION=1.0.0
