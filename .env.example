# Google AI Studio API Key (Gemini 2.0 Flash - Fallback)
# Get your API key from: https://aistudio.google.com/
VITE_GOOGLE_AI_STUDIO_KEY=your_google_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash
VITE_GEMINI_FALLBACK_MODELS=gemini-1.5-pro,gemini-pro

# Development mode
VITE_DEV_MODE=true

# App configuration
VITE_APP_NAME=Vaidyāna
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_VOICE=true
VITE_ENABLE_OCR=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_SARVAM=true
VITE_ENABLE_HYBRID_MODE=true
VITE_ENABLE_GEMINI_FALLBACK=true
VITE_ENABLE_SMART_ROUTING=true
VITE_ENABLE_EMERGENCY_TRIAGE=true
VITE_ENABLE_NEUROMATE=true
VITE_ENABLE_LAB_AI=true

# AI Service Priority (sarvam,gemini,offline)
VITE_AI_SERVICE_PRIORITY=sarvam,gemini,offline

# Offline AI Models Configuration
VITE_WHISPER_MODEL_PATH=/models/whisper-tiny.en.bin
VITE_GPT4ALL_MODEL_PATH=/models/gpt4all-j-1.3-groovy.bin
VITE_COQUI_MODEL_PATH=/models/tts_models--en--ljspeech--tacotron2-DDC

# Analytics (optional)
VITE_ANALYTICS_ID=your_analytics_id_here

# Map Configuration
VITE_OPENSTREETMAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Database Configuration
VITE_DB_NAME=vaidyana_healthcare
VITE_DB_VERSION=1.0

# Performance Configuration
VITE_AI_TIMEOUT=30000
VITE_AI_RETRY_ATTEMPTS=3
VITE_AI_RETRY_DELAY=1000
VITE_ENABLE_CACHING=true
VITE_CACHE_TTL=300000

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here